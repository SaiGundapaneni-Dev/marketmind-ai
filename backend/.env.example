APP_NAME=Vestora AI
APP_VERSION=1.0.0
ENVIRONMENT=development

DATABASE_URL=postgresql://postgres:password@localhost:5400/marketmind_ai

JWT_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
PASSWORD_RESET_EXPIRE_MINUTES=30

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FRONTEND_URL=http://localhost:3000

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Vestora AI
SMTP_USE_TLS=true

LOG_LEVEL=INFO
